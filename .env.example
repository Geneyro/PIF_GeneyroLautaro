# -----------------------------------------------------------------------------
# Copie este archivo como .env.local y complete los valores.
#   cp .env.example .env.local
#
# Ambas variables se leen SOLO en el servidor (Server Actions / Server
# Components). No llevan el prefijo NEXT_PUBLIC_, por lo que nunca se envían
# al navegador.
# -----------------------------------------------------------------------------

# URL de la API de Supabase.
#   Local (npx supabase start): http://127.0.0.1:54321
#   Supabase Cloud:             https://<ref-del-proyecto>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Clave pública del proyecto ("anon key" o "publishable key").
#   Local: ejecute `npx supabase status` y copie "anon key" (o "Publishable key").
#   Cloud: Project Settings > API Keys.
# Con esta clave la app solo puede LEER tablas y EJECUTAR las funciones del
# motor; no puede modificar tablas directamente (ver la migración).
SUPABASE_ANON_KEY=reemplazar-por-la-anon-key

# -----------------------------------------------------------------------------
# Copie este archivo como .env.local y complete los valores.
# .env.local nunca se versiona. En Vercel, las tres primeras variables se cargan
# en Project > Settings > Environment Variables (Production y Preview).
# -----------------------------------------------------------------------------

# URL de la API de Supabase.
#   Local (npx supabase start): la que muestra `npx supabase status` (API URL)
#   Cloud: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública ("anon" o "publishable").
#   Local: `npx supabase status`
#   Cloud: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio ("service_role" o "secret"). SOLO servidor: nunca lleva el
# prefijo NEXT_PUBLIC_ ni se importa desde código de cliente. Se usa para crear
# las cuentas del formulario «Crear cuenta».
#   Local: `npx supabase status`
#   Cloud: Project Settings > API Keys
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Google OAuth («Continuar con Google»). Las usa solo `npm run auth:google`,
# que las guarda en Supabase Auth. NO se cargan en Vercel: la aplicación no
# las necesita.
#   GOOGLE_*: Google Cloud Console > APIs y servicios > Credenciales >
#             ID de cliente de OAuth (aplicación web). URI de redirección:
#             https://<ref-del-proyecto>.supabase.co/auth/v1/callback
#   SUPABASE_ACCESS_TOKEN: supabase.com/dashboard/account/tokens
#   SUPABASE_PROJECT_REF: Project Settings > General > Reference ID
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

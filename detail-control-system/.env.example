# -----------------------------------------------------------------------------
# Copie este archivo como .env.local y complete los valores.
# .env.local nunca se versiona. En Vercel, las variables se cargan en
# Project > Settings > Environment Variables (Production y Preview).
# -----------------------------------------------------------------------------

# URL de la API de Supabase.
#   Local (npx supabase start): la que muestra `npx supabase status` (API URL)
#   Cloud: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública ("anon" o "publishable").
#   Local: `npx supabase status`
#   Cloud: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role. SOLO servidor: nunca lleva el prefijo NEXT_PUBLIC_ ni
# se importa desde código de cliente.
#   Local: `npx supabase status`
#   Cloud: Project Settings > API Keys
SUPABASE_SERVICE_ROLE_KEY=
